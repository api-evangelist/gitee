{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gitee Open API v5 (core subset) Enterprises Organizations API",
    "version": "5.4.92"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access_token",
      "value": "{{access_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organizations the authenticated user belongs to",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gitee.com/api/v5/user/orgs"
          },
          "docs": "List organizations the authenticated user belongs to"
        },
        {
          "info": {
            "name": "Get a single organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gitee.com/api/v5/orgs/:org",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path",
                "description": "The organization path."
              }
            ]
          },
          "docs": "Get a single organization"
        },
        {
          "info": {
            "name": "List all members of an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gitee.com/api/v5/orgs/:org/members",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path",
                "description": "The organization path."
              }
            ]
          },
          "docs": "List all members of an organization"
        }
      ]
    }
  ],
  "bundled": true
}