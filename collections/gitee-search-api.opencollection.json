                "description": "Search keyword."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search repositories"
        },
        {
          "info": {
            "name": "Search issues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gitee.com/api/v5/search/issues",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search keyword."
              }
            ]
          },
          "docs": "Search issues"
        },
        {
          "info": {
            "name": "Search users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gitee.com/api/v5/search/users",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search keyword."
              }
            ]
          },
          "docs": "Search users"
        }
      ]
    }
  ],
  "bundled": true
}