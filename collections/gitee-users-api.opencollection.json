{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gitee Open API v5 (core subset) Enterprises Users API",
    "version": "5.4.92"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access_token",
      "value": "{{access_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the authenticated user's profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gitee.com/api/v5/user"
          },
          "docs": "Get the authenticated user's profile"
        },
        {
          "info": {
            "name": "List the authenticated user's SSH public keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gitee.com/api/v5/user/keys"
          },
          "docs": "List the authenticated user's SSH public keys"
        },
        {
          "info": {
            "name": "Add an SSH public key for the authenticated user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gitee.com/api/v5/user/keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add an SSH public key for the authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}